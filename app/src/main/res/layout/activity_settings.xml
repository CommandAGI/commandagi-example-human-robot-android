<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="#202124"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Connection -->
        <TextView style="@style/SettingsLabel" android:text="CommandAGI API key" />
        <TextView
            android:id="@+id/apiKeyValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#F1F3F4"
            android:padding="14dp"
            android:text="Tap to set"
            android:textColor="#202124"
            android:textSize="15sp" />

        <!-- What am I driving? — segmented toggle (squircle-style preference) -->
        <TextView style="@style/SettingsLabel" android:text="What am I driving?" />
        <LinearLayout
            android:id="@+id/modeToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#F1F3F4"
            android:orientation="horizontal"
            android:padding="4dp">
            <TextView
                android:id="@+id/modeHuman"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="Human"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/modeDrone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="Drone"
                android:textSize="15sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/modeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#5F6368"
            android:textSize="13sp" />

        <!-- ── Human settings ─────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/humanSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <include layout="@layout/row_switch" android:id="@+id/swDictate" />
            <include layout="@layout/row_switch" android:id="@+id/swKeepAwake" />
            <include layout="@layout/row_switch" android:id="@+id/swHaptics" />

            <TextView style="@style/SettingsLabel" android:text="Camera" />
            <LinearLayout
                android:id="@+id/cameraToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#F1F3F4"
                android:orientation="horizontal"
                android:padding="4dp">
                <TextView
                    android:id="@+id/camBack"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="Back"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/camFront"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="Front"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ── Drone settings ─────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/droneSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.commandagi.humanrobot.DroneWiringDiagram
                android:id="@+id/diagram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/espStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="No ESP32 detected. Plug one into the phone’s USB-C port."
                android:textColor="#5F6368"
                android:textSize="13sp" />

            <!-- Collapsible: Wi-Fi networks -->
            <TextView
                android:id="@+id/netsHeader"
                style="@style/SectionHeader"
                android:text="▸  Wi-Fi networks visible to the ESP32" />
            <LinearLayout
                android:id="@+id/netsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/scanButton"
                    style="@style/PrimaryButton"
                    android:text="Scan" />
                <LinearLayout
                    android:id="@+id/netList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Collapsible: Drone status & test control -->
            <TextView
                android:id="@+id/droneHeader"
                style="@style/SectionHeader"
                android:text="▸  Drone status &amp; test control" />
            <LinearLayout
                android:id="@+id/droneBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/droneStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Not connected to a drone."
                    android:textColor="#5F6368"
                    android:textSize="13sp" />
                <GridLayout
                    android:id="@+id/testGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3" />
            </LinearLayout>

            <!-- Collapsible: Learn (smallprint) -->
            <TextView
                android:id="@+id/learnHeader"
                style="@style/SectionHeader"
                android:text="▸  About the ESP32 relay" />
            <LinearLayout
                android:id="@+id/learnBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp" />
    </LinearLayout>
</ScrollView>
